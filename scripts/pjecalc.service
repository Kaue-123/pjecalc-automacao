# Unidade de usuario: o banco H2 fica no $HOME e o servidor so atende em
# localhost. Instalacao e uso no README, secao "Deixando o servidor de pe".
[Unit]
Description=PJe-Calc Cidadao (TRT 8) — servidor local em http://localhost:9257/pjecalc
After=network.target

[Service]
ExecStart=%h/.local/share/pjecalc/pjecalc.sh foreground
# Em SIGTERM a JVM sai com 143 depois de rodar os hooks: saida normal.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
