# Rodada mensal dos indices. Disparada pelo pjecalc-indices.timer; tambem serve
# para rodar na mao: systemctl --user start pjecalc-indices
#
# __PROJETO__ e substituido pelo caminho do repositorio em instalar-automacao.sh.
[Unit]
Description=PJe-Calc — extracao mensal dos indices TR e IPCA-E (TRT 8)
Wants=pjecalc.service
After=pjecalc.service network-online.target

[Service]
Type=oneshot
ExecStart=__PROJETO__/scripts/rodada-mensal.sh
# A extracao passa de 10 min por causa da paginacao do modal.
TimeoutStartSec=45min
