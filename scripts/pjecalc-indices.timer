# "Dia 6, as 11h; se cair no fim de semana, na segunda seguinte."
#
# O systemd nao sabe o que e dia util, entao dispara nos dias 6, 7 e 8 de
# segunda a sexta, e o marcador de mes do rodada-mensal.sh descarta as sobras:
#
#   6 em dia util -> roda no 6     6 no sabado -> roda no 8     6 no domingo -> roda no 7
#
# Feriado nao entra na conta: o systemd nao tem calendario.
[Unit]
Description=Dispara a extracao mensal dos indices do TRT 8

[Timer]
OnCalendar=Mon..Fri *-*-06,07,08 11:00:00
# Maquina desligada na hora marcada: roda assim que ligar.
Persistent=true
# Evita bater no portal do TRT no mesmo segundo que todo mundo.
RandomizedDelaySec=5min
Unit=pjecalc-indices.service

[Install]
WantedBy=timers.target
